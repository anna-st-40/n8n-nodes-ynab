{
  "name": "n8n-nodes-ynab-api",
  "version": "1.0.0",
  "description": "n8n node for the YNAB (You Need A Budget) API with AI Agent support and complete coverage of plans, accounts, categories, payees, payee locations, months, money movements, transactions, and scheduled transactions",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ynab",
    "you need a budget",
    "budget",
    "finance",
    "accounting",
    "personal finance",
    "transactions",
    "budgeting"
  ],
  "license": "MIT",
  "homepage": "https://github.com/anna-st-40/n8n-nodes-ynab#readme",
  "author": {
    "name": "Anna Stefaniv Oickle",
    "email": "anna.stefaniv.oickle@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anna-st-40/n8n-nodes-ynab.git"
  },
  "bugs": {
    "url": "https://github.com/anna-st-40/n8n-nodes-ynab/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "format": "prettier nodes credentials --write",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "NOTICE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/YnabApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Ynab/Ynab.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.48.3",
    "eslint": "^10.10.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "^3.8.3",
    "release-it": "^21.0.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
